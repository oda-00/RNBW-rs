+#[derive(Clone, Copy, Default)]
+struct RansEncodeSymbol {
+    reciprocal: u32,
+    threshold: u32,
+    bias: u16,
+    complement: u16,
+    shift: u8,
+}
+
+impl RansEncodeSymbol {
+    fn new(frequency: u32, cumulative: u32) -> Self {
+        if frequency == 0 {
+            return Self::default();
+        }
+        let threshold = ((RANS_LOWER_BOUND >> RANS_SCALE_BITS) << 8) * frequency;
+        let complement = (RANS_SCALE - frequency) as u16;
+        if frequency == 1 {
+            // mulhi(x, 2^32-1) = x-1 for positive x; bias repairs that
+            // one-unit quotient difference without a per-symbol branch.
+            return Self {
+                reciprocal: u32::MAX,
+                threshold,
+                bias: (cumulative + RANS_SCALE - 1) as u16,
+                complement,
+                shift: 0,
+            };
+        }
+        let shift = u32::BITS - (frequency - 1).leading_zeros();
+        Self {
+            reciprocal: (1u64 << (31 + shift)).div_ceil(u64::from(frequency)) as u32,
+            threshold,
+            bias: cumulative as u16,
+            complement,
+            shift: (shift - 1) as u8,
+        }
+    }
+
+    #[inline]
+    fn advance(self, state: u32) -> u32 {
+        // State is positive and below f*2^19 <= 2^31 after renormalization.
+        // For f>=2, ceil(2^(31+ceil(log2(f)))/f) yields exact floor(state/f):
+        // its rounding error contributes strictly less than 1/f to the quotient.
+        let quotient =
+            (((u64::from(state) * u64::from(self.reciprocal)) >> 32) as u32) >> self.shift;
+        state + quotient * u32::from(self.complement) + u32::from(self.bias)
+    }
+}
